{
  "name": "justcode-vscode",
  "displayName": "JustCode — Lean Coding Assistant",
  "description": "A lean, transparent coding assistant — bring your own provider, control every token.",
  "icon": "media/icon.png",
  "version": "0.3.4",
  "publisher": "kingeke",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/kingeke/justcode.git"
  },
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "justcode",
          "title": "JustCode",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "justcode": [
        {
          "type": "webview",
          "id": "justcode.chatView",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "justcode.openChat",
        "title": "Open Chat"
      },
      {
        "command": "justcode.newSession",
        "title": "New Session",
        "icon": "$(add)"
      },
      {
        "command": "justcode.openSettings",
        "title": "Settings",
        "icon": "$(gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "justcode.openSettings",
          "when": "view == justcode.chatView",
          "group": "navigation@1"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "node esbuild.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lezer/highlight": "^1.2.3"
  }
}
