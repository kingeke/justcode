#!/bin/sh
# Pre-commit hook: format the WHOLE repo with Prettier and stage whatever it
# rewrote, so the formatting fixes ride this commit and the repo can never
# hold unformatted files. Then typecheck. Tests stay in pre-push, so commits
# remain quick. Bypass with `git commit --no-verify` when needed.
#
# Trade-off (deliberate): a file Prettier reformats is staged in full, even if
# it wasn't part of this commit — repo-wide cleanliness over commit purity.

set -e

echo "▶ Formatting with Prettier..."
# The direct binary (not `bun run`) so stdout is only the list of files
# Prettier actually rewrote, which is exactly what gets staged.
changed=$(node_modules/.bin/prettier --write --list-different --log-level warn .)
if [ -n "$changed" ]; then
  printf '%s\n' "$changed" | tr '\n' '\0' | xargs -0 git add --
  echo "  formatted and staged: $changed"
fi

echo "▶ Running typecheck..."
bun run typecheck

echo "✓ Pre-commit checks passed."
