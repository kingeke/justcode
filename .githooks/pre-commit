#!/bin/sh
# Pre-commit hook: auto-format the staged files with Prettier (folding the
# fixes into the commit) and typecheck. Tests stay in pre-push, so commits
# remain quick. Bypass with `git commit --no-verify` when needed.
#
# Note: a partially staged file (git add -p) gets fully re-staged after
# formatting — Prettier rewrites the whole file on disk.

set -e

# Format only the files in this commit, then re-stage them — the re-stage is
# what folds the fixes into the commit being created (no second commit, and no
# unrelated files swept in).
files=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -n "$files" ]; then
  echo "▶ Formatting staged files with Prettier..."
  printf '%s\n' "$files" | tr '\n' '\0' | xargs -0 bun run prettier --write --ignore-unknown --log-level warn --
  printf '%s\n' "$files" | tr '\n' '\0' | xargs -0 git add --
fi

echo "▶ Running typecheck..."
bun run typecheck

echo "✓ Pre-commit checks passed."
